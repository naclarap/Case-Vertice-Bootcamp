# Gateway EloAgents (API compatível com OpenAI)
ELOAGENTS_API_KEY=sk-sua-chave-aqui
ELOAGENTS_BASE_URL=https://chat.eloagents.click/api

# Modelos (nomes confirmados via GET /api/models no gateway).
# Padrão: claude-sonnet-46 nos dois papéis — claude-haiku-45 é mais barato mas,
# em teste, errou a seleção de ferramenta entre as 20 disponíveis com frequência.
# Outros modelos do gateway (claude-opus-47, gemini-*, gpt-*) também funcionam
# tecnicamente, mas só os três Claude foram testados com o protocolo de texto
# AÇÃO/PARÂMETROS que este projeto usa.
VERTICE_MODEL_STEP=claude-sonnet-46
VERTICE_MODEL_FINAL=claude-sonnet-46

# texto = ReAct por parsing de texto (padrão) | nativo = parâmetro tools= da API
VERTICE_TOOL_MODE=texto

# Limite de iterações do loop ReAct
VERTICE_MAX_ITER=8

# Teto de tokens da resposta. VAZIO = sem teto, e é o padrão.
# Cortar por token corta no meio da frase, e a resposta final tem contrato de
# quatro seções — truncar perde a FORÇA DA EVIDÊNCIA. Para encurtar de verdade,
# aperte o bloco CONCISÃO em vertice/agent/prompts.py. Este teto é rede contra
# resposta disparada, não estilo.
# VERTICE_MAX_TOKENS=700

# Pasta dos CSVs (padrão: ./data)
# VERTICE_DATA_DIR=/caminho/para/os/csvs
